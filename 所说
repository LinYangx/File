/* ===== 视频区右侧：垂直分页栏 ===== */
.fav-list-main {
    display: flex !important;
    flex-wrap: wrap !important;
    align-items: stretch !important;
    column-gap: 12px !important;
}

/* 排序与搜索栏仍独占一行 */
.fav-list-main > .fav-list-header {
    flex: 0 0 100% !important;
    width: 100% !important;
}

/* 视频网格占据分页栏左侧的剩余空间 */
.fav-list-main > .items {
    flex: 1 1 0 !important;
    width: auto !important;
    min-width: 0 !important;
}

/* 分页栏固定在视频内容区右侧 */
.fav-list-main > .card-pagenation {
    flex: 0 0 64px !important;
    align-self: stretch !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    gap: 8px !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* 页码按钮改为纵向排列 */
.card-pagenation .vui_pagenation--btns {
    display: flex !important;
    flex-flow: column nowrap !important;
    align-items: center !important;
    gap: 4px !important;
}

/* 统一数字页码按钮尺寸 */
.card-pagenation .vui_pagenation--btn {
    flex: none !important;
    width: 36px !important;
    min-width: 36px !important;
    height: 30px !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* “上一页”和“下一页”稍宽 */
.card-pagenation .vui_pagenation--btn-side {
    width: 56px !important;
}

/* 跳页控件纵向排列 */
.card-pagenation .vui_pagenation-go {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    gap: 6px !important;
    margin: 0 !important;
}

.card-pagenation .vui_pagenation-go__count {
    width: 64px;
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
    white-space: normal !important;
}

/* 缩小页码输入框以适应侧栏 */
.card-pagenation .vui_pagenation-go .vui_input,
.card-pagenation .vui_pagenation-go .vui_input-wrapper,
.card-pagenation .vui_pagenation-go input {
    width: 44px !important;
    min-width: 0 !important;
}

.card-pagenation .vui_pagenation-go input {
    text-align: center;
}
