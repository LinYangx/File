/* ==UserStyle==
@name           Bilibili视频页：紧凑宽屏
@namespace      xdcedar.stylus
@author         LinYang
@description    隐藏顶栏、扩展视频区、压缩标题与作者区域，并优化作者栏及右侧推荐卡片布局。
@version        20261112.7
@preprocessor   default
==/UserStyle== */

@-moz-document
  url-prefix("https://www.bilibili.com/video/"),
  url-prefix("https://bilibili.com/video/") {

  /* ==================== 可调参数 ==================== */
  :root {
    /* 同时控制页面左右留白和左右两栏间距。 */
    --bili-video-page-gutter: 8px;

    /* 标题区与作者区共用高度，保持左右顶部对齐。 */
    --bili-video-header-height: 76px;
    --bili-video-header-padding-top: 8px;
    --bili-video-header-padding-bottom: 6px;
    --bili-video-title-line-height: 30px;

    /* 作者信息。999px 为圆形头像；改为 0 可变成方角。 */
    --bili-up-avatar-radius: 999px;
    --bili-up-avatar-gap: 12px;
    --bili-follow-height: 26px;
    --bili-follow-min-width: 80px;
    --bili-follow-padding-x: 12px;
    --bili-follow-radius: 4px;
    --bili-follow-font-size: 13px;

    /* 推荐封面尺寸及封面与标题的间距。 */
    --bili-rec-cover-width: 170px;
    --bili-rec-cover-height: 96px;
    --bili-rec-info-gap: 10px;
  }

  /* ==================== 全局与主布局 ==================== */
  #biliMainHeader,
  .usercard-wrap {
    display: none !important;
  }

  #app.app-v1 {
    padding-top: 0 !important;
  }

  .video-container-v1 {
    box-sizing: border-box !important;
    width: 100% !important;
    max-width: none !important;
    margin-inline: 0 !important;
    padding-inline: var(--bili-video-page-gutter) !important;
  }

  /* 覆盖 B 站动态写入的固定宽度，让左栏占满剩余空间。 */
  .video-container-v1 > .left-container {
    flex: 1 1 0 !important;
    width: auto !important;
    min-width: 0 !important;
    max-width: none !important;
    margin-inline: 0 !important;
  }

  .video-container-v1 > .right-container {
    flex: 0 0 auto !important;
    margin-left: var(--bili-video-page-gutter) !important;
  }

  .video-container-v1 > .left-container
    :is(#playerWrap, #bilibili-player) {
    width: 100% !important;
    max-width: none !important;
  }

  /* ==================== 标题信息区 ==================== */
  .video-info-container {
    height: var(--bili-video-header-height) !important;
    min-height: 0 !important;
    padding-block:
      var(--bili-video-header-padding-top)
      var(--bili-video-header-padding-bottom) !important;
  }

  .video-info-container .video-info-title-inner .video-title {
    line-height: var(--bili-video-title-line-height) !important;
  }

  .video-info-container .video-info-meta {
    margin-top: 2px !important;
  }

  /* 隐藏“未经作者授权，禁止转载”等版权声明。 */
  .video-info-container .video-info-meta .copyright {
    display: none !important;
  }

  /* ==================== 作者信息区 ==================== */
  .up-info-container {
    height: var(--bili-video-header-height) !important;
    min-height: 0 !important;
    padding-block: 0 !important;
  }

  .up-info-container .up-info--left {
    flex: 0 0 auto !important;
    align-self: center !important;
  }

  .up-info-container :is(.up-avatar, .bili-avatar, .bili-avatar-img) {
    border-radius: var(--bili-up-avatar-radius) !important;
  }

  /* 头像、作者名、关注按钮按单行排列并垂直居中。 */
  .up-info-container .up-info--right {
    display: flex !important;
    align-items: center !important;
    flex: 1 1 auto !important;
    min-width: 0 !important;
    margin-left: var(--bili-up-avatar-gap) !important;
    overflow: visible !important;
  }

  .up-info-container :is(.up-info__detail, .up-detail) {
    flex: 1 1 auto !important;
    min-width: 0 !important;
  }

  .up-info-container :is(.up-info__detail, .up-detail-top) {
    display: flex !important;
    align-items: center !important;
    margin: 0 !important;
  }

  .up-info-container .up-detail-top {
    min-width: 0 !important;
  }

  .up-info-container .up-name {
    flex: 0 1 auto !important;
    min-width: 0 !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
  }

  /* 仅保留作者名和关注按钮。 */
  .up-info-container :is(.up-description, .send-msg),
  .up-info-container .upinfo-btn-panel :is(
    .charge-btn,
    .old-charge-btn,
    .new-charge-btn,
    .following-charge-btn,
    .not-follow-charge-btn
  ) {
    display: none !important;
  }

  .up-info-container .up-info__btn-panel {
    flex: 0 0 auto !important;
    margin: 0 0 0 auto !important;
    padding: 0 !important;
  }

  .up-info-container .upinfo-btn-panel {
    margin: 0 !important;
  }

  .up-info-container .upinfo-btn-panel .follow-btn {
    flex: 0 0 auto !important;
    box-sizing: border-box !important;
    width: auto !important;
    min-width: var(--bili-follow-min-width) !important;
    max-width: none !important;
    height: var(--bili-follow-height) !important;
    min-height: 0 !important;
    padding: 0 var(--bili-follow-padding-x) !important;
    border-radius: var(--bili-follow-radius) !important;
    font-size: var(--bili-follow-font-size) !important;
    line-height: var(--bili-follow-height) !important;
  }

  /* ==================== 推荐列表 ==================== */
  .recommend-list-v1 .video-page-special-card-small {
    display: none !important;
  }

  .recommend-list-v1
    :is(.video-page-card-small, .video-page-operator-card-small)
    .pic-box {
    flex: 0 0 var(--bili-rec-cover-width) !important;
    width: var(--bili-rec-cover-width) !important;
    height: var(--bili-rec-cover-height) !important;
    border-radius: 0 !important;
  }

  /* 封面及所有覆盖层统一使用方角。 */
  .recommend-list-v1
    :is(.video-page-card-small, .video-page-operator-card-small)
    .pic-box :is(
      .pic,
      .framepreview-box,
      .video-awesome-img,
      .b-img,
      .b-img__inner,
      .bpx-docker-major,
      .watch-later-video
    ) {
    border-radius: 0 !important;
  }

  .recommend-list-v1
    :is(.video-page-card-small, .video-page-operator-card-small)
    .pic-box .pic.loaded::before {
    border-radius: 0 !important;
  }

  /* 清除原站预览层的定位与固定尺寸。 */
  .recommend-list-v1
    :is(.video-page-card-small, .video-page-operator-card-small)
    .pic-box :is(.framepreview-box, .video-awesome-img) {
    inset: 0 !important;
  }

  .recommend-list-v1
    :is(.video-page-card-small, .video-page-operator-card-small)
    .pic-box :is(
      .framepreview-box,
      .video-awesome-img,
      .b-img,
      .b-img__inner,
      .bpx-docker-major
    ) {
    width: 100% !important;
    height: 100% !important;
  }

  /* 信息列占满剩余宽度，播放数据与封面底边对齐。 */
  .recommend-list-v1
    :is(.video-page-card-small, .video-page-operator-card-small)
    .info {
    display: flex !important;
    flex-direction: column !important;
    flex: 1 1 auto !important;
    box-sizing: border-box !important;
    width: calc(
      100% - var(--bili-rec-cover-width) - var(--bili-rec-info-gap)
    ) !important;
    min-width: 0 !important;
    height: var(--bili-rec-cover-height) !important;
    margin-left: var(--bili-rec-info-gap) !important;
  }

  .recommend-list-v1
    :is(.video-page-card-small, .video-page-operator-card-small)
    .info .playinfo {
    flex: 0 0 auto !important;
    margin-top: auto !important;
  }

  /*
   * 可选：播放器扩宽后按 16:9 同步增高。
   * 默认关闭，以免改变竖屏或其他比例视频的显示。
   */
  /*
  .video-container-v1 > .left-container
    :is(#playerWrap, #bilibili-player) {
    height: auto !important;
    aspect-ratio: 16 / 9;
  }
  */
}
