/* ==UserStyle==
@name           Bilibili收藏页
@namespace      xdcedar.stylus
@author         LinYang
@description    更好看更好用的Bilibili收藏页
@version        20261112
@homepageURL    https://github.com/XDcedar/bilibili-better-favorite-list
@license        .
@preprocessor   default
==/UserStyle== */

/* 收藏页：新版界面与旧版通用样式 */
@-moz-document regexp("^https?://space\\.bilibili\\.com/\\d+/favlist.*") {

  /* ==================== 通用变量区 ==================== */
  main.space-main {
    --bbfl-video-columns: 8;         /* 视频列表列数 */
    --bbfl-page-gutter: 10px;        /* 页面左右留白 */
    --bbfl-video-gap: 10px;          /* 视频卡片间距 */
    --bbfl-detail-gap: 10px;         /* 详情区按钮与文字间距 */
    --bbfl-grid-columns: 13;         /* 收藏夹列表列数 */
  }
    
  /* ==================== 页面布局(新版界面) ==================== */
  main.space-main.route_favlist,
  main.space-main.route_favlist > .space-favlist {
    box-sizing: border-box !important;
    width: 100% !important;
    max-width: none !important;
  }

  main.space-main.route_favlist {
    margin-inline: 0 !important;
    padding-inline: var(--bbfl-page-gutter) !important;
  }

  /* 顶部导航隐藏后,清除原有的负边距。 */
  #app {
    margin-top: 0 !important;
  }

  /* 侧边栏与内容区纵向排列,侧边栏扩展至全宽。 */
  main.space-main .space-favlist {
    display: flex;
    flex-direction: column;
  }

  main.space-main .space-favlist .favlist-aside {
    --aside-width: 100%;
    position: static;
  }

  .fav-collapse-wrap {
    max-height: 300px;
  }

  /* ==================== 通用收藏夹网格(新版界面) ==================== */

  /*
   * 1. 通过"新建收藏夹"按钮识别"我创建的收藏夹"；
   * 2. 通过 :not() 适配合集、其他收藏及其他用户的收藏夹。
   */
  .fav-collapse .vui_collapse_item_content
    .fav-collapse-create + .vui_sidebar .fav-sortable-list,

  .fav-collapse .vui_collapse_item_content
    .vui_sidebar:not(.fav-collapse-create + .vui_sidebar) {
    display: grid;
    grid-template-columns:
      repeat(var(--bbfl-grid-columns), minmax(0, 1fr));
    justify-content: stretch;
  }

  /* 缩短"新建收藏夹"按钮,避免误触。 */
  .fav-collapse-wrap > .fav-collapse-create {
    width: calc(100% / var(--bbfl-grid-columns));
  }

  /* 默认收藏夹不在可排序列表中,需要单独调整宽度。 */
  .fav-collapse .vui_collapse_item_content
    .vui_sidebar > .fav-sidebar-item:has(+ .fav-sortable-list) {
    width: calc(100% / var(--bbfl-grid-columns));
  }

  .fav-sidebar-item .vui_sidebar-item-title .vui_ellipsis {
    max-width: stretch;
    margin-right: 5px;
  }

  /* ==================== 我创建的收藏夹(新版界面) ==================== */

  /*
   * 将新建按钮、默认收藏夹和其他收藏夹放入同一个网格。
   * 新建按钮占第一列,默认收藏夹占第二列,其余项目自动排列。
   */
  .favlist-aside .fav-collapse:has(.fav-collapse-create)
    .fav-collapse-wrap {
    display: grid !important;
    grid-template-columns:
      repeat(var(--bbfl-grid-columns), minmax(0, 1fr)) !important;
    gap: 6px 8px !important;
    align-items: center;
  }

  /* 展开中间容器,使所有收藏夹直接参与网格布局。 */
  .favlist-aside .fav-collapse:has(.fav-collapse-create)
    :is(.vui_sidebar, .fav-sortable-list) {
    display: contents !important;
  }

  .favlist-aside .fav-collapse:has(.fav-collapse-create)
    .fav-collapse-create {
    grid-column: 1;
    grid-row: 1;
    width: auto !important;
    margin: 0 !important;
  }

  .favlist-aside .fav-collapse:has(.fav-collapse-create)
    .vui_sidebar > .fav-sidebar-item {
    grid-column: 2;
    grid-row: 1;
  }

  .favlist-aside .fav-collapse:has(.fav-collapse-create)
    .fav-sidebar-item {
    width: auto !important;
    min-width: 0 !important;
    margin: 0 !important;
  }


  /* ==================== 隐藏指定元素(新版界面) ==================== */
  #biliMainHeader,
  .space-header,
  .space-navbar,

  /* 我追的合集/收藏夹 */
  .favlist-aside > .vui_collapse > .fav-collapse:nth-child(2),

  /* 其他收藏 */
  .favlist-aside
    .fav-collapse:has(.fav-sidebar-item[title="话题收藏"]),

  /* 我的笔记本 */
  .favlist-aside .fav-collapse:has(a[href*="/v/note-list"]),

  /* 详情区封面、转发和点赞 */
  .favlist-info-file-card,
  .favlist-info .favlist-info-action,

  /* 详情区标题、公开状态和播放量 */
  .favlist-info-detail__title-row,
  .favlist-info-detail__data .status,
  .favlist-info-detail__data > div > span:last-child {
    display: none !important;
  }


  /* ==================== 收藏夹详情区(新版界面) ==================== */
  .space-favlist > .favlist-main {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  .favlist-main > .favlist-info {
    display: flex !important;
    justify-content: flex-start !important;
    align-items: center !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 10px 0 !important;
  }

  .favlist-info-detail {
    display: flex !important;
    flex-direction: row !important;
    justify-content: flex-start !important;
    align-items: center !important;
    align-content: center !important;
    gap: var(--bbfl-detail-gap) !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* 展开按钮容器,让按钮与视频数参与同一弹性布局。 */
  .favlist-info-detail__actions {
    display: contents !important;
  }

  .favlist-info-detail__data,
  .favlist-info-detail__data > div,
  .favlist-info-detail__data > div > span:nth-child(2) {
    margin: 0 !important;
  }

  .favlist-info-detail__title {
    order: 3;
    flex: 0 0 auto !important;
    margin: 0 !important;
  }

  .favlist-info-detail__actions
    :is(.playall-btn, .favlist-info-batch) {
    flex: none !important;
    margin: 0 !important;
  }

  /* 当前实际顺序：播放全部 → 批量操作 → 视频数。 */
  .favlist-info-detail__actions .playall-btn {
    order: 1;
  }

  .favlist-info-detail__actions .favlist-info-batch {
    order: 2;
  }

  .favlist-info-detail__title,
  .favlist-info-detail__actions
    :is(.playall-btn, .favlist-info-batch) {
    align-self: center !important;
  }

  /* ==================== 视频列表(新版界面) ==================== */
  .fav-list-main > .items {
    display: grid !important;
    grid-template-columns:
      repeat(var(--bbfl-video-columns), minmax(0, 1fr)) !important;
    gap: var(--bbfl-video-gap) !important;
  }

  .fav-list-main > .items > .items__item {
    width: auto !important;
    min-width: 0 !important;
    margin: 0 !important;
  }

/* ==================== 视频区右侧：垂直分页栏 ==================== */
/* 清除各层容器的右侧留白,让分页栏贴齐页面右缘。 */
main.space-main.route_favlist,
main.space-main.route_favlist > .space-favlist,
main.space-main.route_favlist .favlist-main {
    margin-right: 8px !important;
    padding-right: 0 !important;
}

.fav-list-main {
    --pagination-width: 36px;
    --pagination-control-height: 30px;
    --pagination-gap: 4px;

    display: flex !important;
    flex-wrap: wrap !important;
    align-items: stretch !important;
    box-sizing: border-box !important;
    width: 100% !important;
    max-width: none !important;
    margin-right: 0 !important;
    padding-right: 0 !important;
    column-gap: 8px !important;
}

/* 排序与搜索栏独占一行。 */
.fav-list-main > .fav-list-header {
    flex: 0 0 100% !important;
    width: 100% !important;
}

/* 视频网格占据分页栏左侧的剩余空间。 */
.fav-list-main > .items {
    flex: 1 1 0 !important;
    width: auto !important;
    min-width: 0 !important;
}

/* 分页栏固定在 flex 行尾。 */
.fav-list-main > .card-pagenation {
    flex: 0 0 var(--pagination-width) !important;
    align-self: stretch !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    gap: var(--pagination-gap) !important;
    margin: 0 0 0 auto !important;
    padding: 0 !important;
}

/* 隐藏上一页、下一页及统计信息。 */
.card-pagenation .vui_pagenation--btn-side,
.card-pagenation .vui_pagenation-go__count {
    display: none !important;
}

/* 页码与跳页控件使用相同的宽度、轴线和间距。 */
.card-pagenation
    :is(.vui_pagenation--btns, .vui_pagenation-go) {
    display: flex !important;
    flex-flow: column nowrap !important;
    align-items: center !important;
    box-sizing: border-box !important;
    gap: var(--pagination-gap) !important;
    width: var(--pagination-width) !important;
    margin: 0 !important;
    padding: 0 !important;
}

.card-pagenation .vui_pagenation--btn {
    flex: none !important;
    width: var(--pagination-width) !important;
    min-width: var(--pagination-width) !important;
    height: var(--pagination-control-height) !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* 跳页输入框与数字页码保持相同尺寸。 */
.card-pagenation .vui_pagenation-go
    :is(.vui_input, .vui_input-wrapper) {
    flex: none !important;
    box-sizing: border-box !important;
    width: var(--pagination-width) !important;
    min-width: 0 !important;
    height: var(--pagination-control-height) !important;
    margin: 0 !important;
    padding: 0 !important;
}

.card-pagenation .vui_pagenation-go input {
    box-sizing: border-box !important;
    width: 100% !important;
    min-width: 0 !important;
    height: var(--pagination-control-height) !important;
    margin: 0 !important;
    padding: 0 4px !important;
    text-align: center;
}

.card-pagenation .vui_pagenation-go__page {
    align-self: center !important;
    width: 100% !important;
    margin: 0 !important;
    line-height: 1;
    text-align: center;
}

/* ==================== 清除视频区底部留白 ==================== */
#app,
main.space-main.route_favlist,
main.space-main.route_favlist > .space-favlist,
main.space-main.route_favlist .favlist-main,
.fav-list-main,
.fav-list-main > .items {
    margin-bottom: 1px !important;
    padding-bottom: 0 !important;
}

/* 防止固定高度或最小高度留下额外空白 */
.fav-list-main,
.fav-list-main > .items {
    height: auto !important;
    min-height: 0 !important;
}
    
  /* ==================== (旧版界面)收藏夹侧边栏 ==================== */
  #page-fav {
    --bbfl-legacy-grid-columns: 4;
  }

  #page-fav .fav-sidenav {
    width: 100%;
  }

  #page-fav .fav-sidenav
    .fav-list-container#fav-createdList-container {
    max-height: 300px;
  }

  /* 保持较矮且可滚动,因为滚动才会加载更早的订阅。 */
  #page-fav .fav-sidenav .fav-list-container#fav-list-container {
    max-height: 162px;
  }

  /* 右侧为滚动条预留 15px。 */
  #page-fav .fav-list {
    display: grid;
    grid-template-columns:
      repeat(var(--bbfl-legacy-grid-columns), minmax(0, 1fr));
    justify-content: stretch;
    margin-right: 15px;
  }

  /*
   * 默认收藏夹不在 .fav-list 中,需要与列表项等宽。
   * 计算方式：(可用宽度 − 滚动条宽度)÷ 列数 − 左右内边距。
   */
  #page-fav .fav-list-container > .fav-item {
    width: calc(
      (100% - 15px) / var(--bbfl-legacy-grid-columns) - 20px
    );
  }

  #page-fav .fav-item {
    display: flex;
    align-items: center;
  }

  /* 仅调整视频收藏夹,不影响话题、专栏等收藏夹。 */
  #page-fav .fav-container .text {
    flex-grow: 1;
    line-height: 35px;
  }

  #page-fav .fav-sidenav .num {
    width: auto;
    margin-right: 5px;
  }

  /* 悬停时仍显示视频收藏数。 */
  #page-fav .col-full.master .fav-container .fav-item:hover .num {
    display: inline-block;
  }

  /* ==================== (旧版界面)收藏内容区 ==================== */
  #page-fav .fav-main {
    width: 100%;
    border-top: 10px solid #eee;
  }

  /*
   * B站新增的 .clearfix 伪元素会在 Grid 首尾产生空白格子。
   * 将首个伪元素移到新行行尾；设为 8 以兼容行数较多的话题收藏夹。
   */
  .clearfix::before {
    grid-row-end: 8;
  }
}

/* 视频页：收藏弹窗 */
@-moz-document url-prefix("https://www.bilibili.com/video/") {
  :is(.collection-m, .collection-m-exp) {
    --bbfl-dialog-grid-columns: 3;
    width: 950px;
  }

  :is(.collection-m, .collection-m-exp) .content .group-list {
    max-height: unset;
  }

  :is(.collection-m, .collection-m-exp) .content .group-list ul {
    display: grid;
    grid-template-columns:
      repeat(var(--bbfl-dialog-grid-columns), minmax(0, 1fr));
    row-gap: 2px;
    justify-content: stretch;
  }

  :is(.collection-m, .collection-m-exp) .content .group-list li {
    height: 25px;
    padding: 3px 10px;
  }

  :is(.collection-m, .collection-m-exp) .content .group-list li label {
    display: flex;
    align-items: center;
  }

  /* 防止标题过长时挤扁勾选框。 */
  :is(.collection-m, .collection-m-exp)
    .content .group-list li input[type="checkbox"] + i {
    min-width: 20px;
    margin-right: 10px;
  }

  /* 防止"私密"标签因标题过长而换行。 */
  :is(.collection-m, .collection-m-exp)
    .content .group-list li label .personal {
    white-space: nowrap;
  }

  :is(.collection-m, .collection-m-exp)
    .content .group-list li label .count {
    margin-left: auto;
  }

  :is(.collection-m, .collection-m-exp) .bottom .btn {
    position: absolute;
    right: 40px;
  }

  :is(.collection-m, .collection-m-exp)
    .content .group-list .add-group {
    position: absolute;
    bottom: 18px;
  }
}

/* 旧版界面：视频收藏夹 */
@-moz-document
  regexp("^https?://space\\.bilibili\\.com/\\d+/favlist$"),
  regexp("^https?://space\\.bilibili\\.com/\\d+/favlist\\?fid=\\d+.*$") {

  #page-fav .fav-main .fav-video-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    row-gap: 20px;
  }

  /* 统一列表项间距,并覆盖第五项原有的特殊右边距。 */
  #page-fav .fav-main .small-item,
  #page-fav .fav-main .small-item:nth-child(5n) {
    justify-self: center;
    margin: 0 5px;
  }
}

/* 旧版界面：话题收藏夹 */
@-moz-document regexp(
  "^https?://space\\.bilibili\\.com/\\d+/favlist\\?fid=topic"
) {
  #page-fav .fav-main .fav-video-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    row-gap: 20px;
  }

  #page-fav .fav-main .fav-video-list.topic-list .large-item {
    justify-self: center;
    margin: 0;
  }
}

/* 旧版界面：课程收藏夹 */
@-moz-document regexp(
  "^https?://space\\.bilibili\\.com/\\d+/favlist\\?fid=pugvfav"
) {
  #page-fav .fav-main .fav-pugv-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    row-gap: 20px;
  }

  #page-fav .fav-content .fav-pugv-list .pugv-item {
    justify-self: center;
    margin: 0;
  }
}
