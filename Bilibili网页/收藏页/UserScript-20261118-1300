// ==UserScript==
// @name         Bilibili收藏页-浮层与菜单事件修复
// @namespace    xdcedar.stylus
// @version      20261118-3
// @description  移除指定原生 title 浮层，将收藏夹溢出菜单改为点击打开，并隔离主按钮导航。
// @match        https://space.bilibili.com/*/favlist*
// @run-at       document-start
// @grant        none
// @noframes
// ==/UserScript==

/*
 * 配合《Bilibili收藏页-浮层与菜单修复版》Stylus 使用。
 * 本脚本只处理 DOM 属性与事件，不负责布局、配色或元素显隐。
 */
(() => {
  "use strict";

  const PAGE = "main.space-main.route_favlist";
  const CREATED_FOLDERS =
    `${PAGE} .favlist-aside .fav-collapse:has(.fav-collapse-create)`;
  const FOLDER_ITEM = `${CREATED_FOLDERS} .fav-sidebar-item`;
  const FOLDER_MENU =
    `${FOLDER_ITEM} .vui_sidebar-item-title > .menu-popover`;
  const FOLDER_MENU_ICON = `${FOLDER_MENU} > i.more-vertical`;

  // 仅移除三类已确认的原生提示，不处理其他 title 或页面弹出层。
  const NATIVE_TITLE_SELECTOR = [
    `${PAGE} .fav-list-main .bili-video-card__title[title]`,
    `${PAGE} .fav-list-main .bili-video-card__author .bili-video-card__text > span[title]`,
    `${FOLDER_ITEM}[title]`,
  ].join(",");

  const preparedMenus = new WeakSet();
  const openMenus = new Set();

  function stripNativeTitle(element) {
    if (!element || element.nodeType !== Node.ELEMENT_NODE) return;
    const value = element.getAttribute("title");
    if (value === null) return;

    // 暂存全文，避免丢失数据；data-bbfl-title 不会触发浏览器原生提示。
    element.setAttribute("data-bbfl-title", value);
    element.removeAttribute("title");
  }

  function stripNativeTitles(root) {
    if (!root) return;
    if (root.nodeType === Node.ELEMENT_NODE && root.matches(NATIVE_TITLE_SELECTOR)) {
      stripNativeTitle(root);
    }
    if (root.querySelectorAll) {
      root.querySelectorAll(NATIVE_TITLE_SELECTOR).forEach(stripNativeTitle);
    }
  }

  /*
   * 原站 VPopover 在悬停模式中通过 mouseenter / mouseleave 打开、关闭菜单。
   * 这里仅允许脚本在单击后转发的非受信任事件进入原处理器；
   * 真实鼠标的悬停与停留均在捕获阶段拦截，不会产生原站的延迟打开定时器。
   */
  function blockRealFolderHover(event) {
    if (!event.isTrusted || !(event.target instanceof Element)) return;
    if (!event.target.closest(FOLDER_MENU_ICON)) return;
    event.preventDefault();
    event.stopImmediatePropagation();
  }

  function dispatchPopoverHover(icon, type) {
    icon.dispatchEvent(new MouseEvent(type, {
      bubbles: false,
      cancelable: false,
      view: window,
    }));
  }

  function closeFolderMenu(menu) {
    openMenus.delete(menu);
    const icon = menu.querySelector(":scope > i.more-vertical");
    if (icon) dispatchPopoverHover(icon, "mouseleave");
  }

  /*
   * 原站 VSidebarItem 在父级 .vui_sidebar-item 上用 onClick 导航。
   * 本监听器位于 .menu-popover 冒泡阶段：三点图标的原监听器先执行，
   * 随后才阻止冒泡和默认行为，因此不会触发外层收藏夹导航。
   * Teleport 到 body 的“编辑信息”“删除”等菜单项不经过此监听器。
   */
  function toggleFolderMenu(event) {
    event.preventDefault();
    event.stopPropagation();

    const menu = event.currentTarget;
    const icon = menu.querySelector(":scope > i.more-vertical");
    if (!icon) return;

    if (openMenus.has(menu)) {
      closeFolderMenu(menu);
      return;
    }

    // 与原站单菜单交互保持一致：打开当前菜单前关闭其他收藏夹菜单。
    for (const other of [...openMenus]) {
      if (other !== menu) closeFolderMenu(other);
    }
    openMenus.add(menu);
    dispatchPopoverHover(icon, "mouseenter");
  }

  function prepareFolderMenu(menu) {
    if (preparedMenus.has(menu)) return;
    menu.addEventListener("click", toggleFolderMenu);
    menu.dataset.bbflMenuTrigger = "click";
    preparedMenus.add(menu);
  }

  function prepareFolderMenus(root) {
    if (!root?.querySelectorAll) return;
    if (root.nodeType === Node.ELEMENT_NODE && root.matches(FOLDER_MENU)) {
      prepareFolderMenu(root);
    }
    root.querySelectorAll(FOLDER_MENU).forEach(prepareFolderMenu);
  }

  function handleOutsideClick(event) {
    if (!(event.target instanceof Element)) return;
    // 菜单面板由 Vue Teleport 到 body；面板内部点击不视为外部点击。
    if (event.target.closest(".vui_popover")) return;

    for (const menu of [...openMenus]) {
      if (!menu.isConnected) {
        openMenus.delete(menu);
      } else if (!menu.contains(event.target)) {
        closeFolderMenu(menu);
      }
    }
  }

  function repairWithin(root) {
    stripNativeTitles(root);
    prepareFolderMenus(root);
  }

  function start() {
    // 捕获监听器对新插入的菜单同样有效，不依赖 Vue 内部实例或私有字段。
    document.addEventListener("mouseenter", blockRealFolderHover, true);
    document.addEventListener("mouseleave", blockRealFolderHover, true);
    document.addEventListener("click", handleOutsideClick, true);

    repairWithin(document);

    const observer = new MutationObserver((records) => {
      for (const record of records) {
        if (record.type === "attributes" && record.attributeName === "title") {
          // Vue 重渲染可能重新写回 title，需要再次移除。
          stripNativeTitle(record.target);
          continue;
        }
        for (const node of record.addedNodes) {
          if (node.nodeType === Node.ELEMENT_NODE) repairWithin(node);
        }
      }
      for (const menu of [...openMenus]) {
        if (!menu.isConnected) openMenus.delete(menu);
      }
    });

    observer.observe(document.documentElement, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ["title"],
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start, { once: true });
  } else {
    start();
  }
})();
