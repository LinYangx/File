/* ==================== 色条 ==================== */
body {
--hbar-1: hsla(360, 80%, 60%, 0.85);     /* 红 */
--hbar-2: hsla(260, 88%, 66%, 0.85);     /* 紫 */
--hbar-3: hsla(50, 100%, 50%, 0.85);     /* 黄 */
--hbar-4: hsla(150, 50%, 50%, 0.85);     /* 绿 */
--hbar-5: hsla(200, 100%, 50%, 0.85);    /* 蓝 */
--hbar-6: hsla(260, 88%, 66%, 0.8);      /* 紫 */
}

/* 通用样式(实时预览&阅读模式) */
.cm-line[class*="HyperMD-header-"]::before,
.markdown-rendered :is(h1,h2,h3,h4,h5,h6)::before {
content: "";
display: inline-block;
width: 14px;
height: 1em;
margin-right: 4px;
vertical-align: -0.1em;
background: var(--hbar-color);
}

/* 隐藏标题折叠箭头 */
.cm-fold-indicator,
.markdown-reading-view .collapse-indicator {
opacity: 0;
}
.cm-fold-indicator:hover,
.markdown-reading-view .collapse-indicator:hover {
opacity: 1;
}

/* ==================== 色块 ==================== */
.theme-dark {
/* 方块底色 */
--h1-block-bg: hsla(360, 80%, 60%, 0.5);
--h2-block-bg: hsla(260, 88%, 66%, 0.5);
--h3-block-bg: hsla(50, 100%, 50%, 0.65);
--h4-block-bg: hsla(150, 50%, 50%, 0.7);
/* 文字右侧至行尾的底色 */
--h1-after-bg: hsla(360, 80%, 60%, 0.6);
--h2-after-bg: hsla(260, 88%, 66%, 0.4);
/* 文字基准色 */
--h1-text-base: var(--text-normal);
--h2-text-base: var(--text-normal);
--h3-text-base: var(--text-normal);
--h4-text-base: var(--text-normal);
/* 文字亮度 */
--h1-text-level: 90%;
--h2-text-level: 0%;
--h3-text-level: 0%;
--h4-text-level: 0%;
}

/* H1方块(实时预览) */
.theme-dark .cm-line.HyperMD-header-1 .cm-header-1 {
background: var(--h1-block-bg);
padding: 0em 0.2em;
color: color-mix(in srgb, var(--h1-text-base) var(--h1-text-level), black);
-webkit-box-decoration-break: clone;
box-decoration-break: clone;
}

/* H2方块(实时预览) */
.theme-dark .cm-line.HyperMD-header-2 .cm-header-2 {
background: var(--h2-block-bg);
padding: 0em 0.3em;
color: color-mix(in srgb, var(--h2-text-base) var(--h2-text-level), black);
-webkit-box-decoration-break: clone;
box-decoration-break: clone;
}

/* H1、H2整行色块 */
.theme-dark .markdown-rendered h1,
.theme-dark .markdown-rendered h2 {
display: flex;
align-items: stretch;
box-sizing: border-box;
}

/* CodeMirror编辑行保持block,避免输入#时因突然切换flex布局而导致光标跳到下一行 */
.theme-dark .markdown-source-view.mod-cm6 .cm-line.HyperMD-header-1,
.theme-dark .markdown-source-view.mod-cm6 .cm-line.HyperMD-header-2 {
display: block;
position: relative;
box-sizing: border-box;
}

/* (阅读模式)文字右侧的渐变填充 */
.theme-dark .markdown-rendered h1::after,
.theme-dark .markdown-rendered h2::after {
content: "";
flex: 1 1 auto;
min-width: 0;
}

/* 右侧渐变改为绝对定位,不参与编辑行布局,通过锚点从标题文字末尾开始,视觉效果与原flex实现一致 */
.theme-dark .markdown-source-view.mod-cm6 .cm-line.HyperMD-header-1::after,
.theme-dark .markdown-source-view.mod-cm6 .cm-line.HyperMD-header-2::after {
content: "";
position: absolute;
position-anchor: --heading-text;
top: 0;
right: 0;
bottom: 0;
left: anchor(right);
min-width: 0;
pointer-events: none;
}

.theme-dark .cm-line.HyperMD-header-1,
.theme-dark .markdown-rendered h1 {
background: var(--h1-block-bg);
}

.theme-dark .cm-line.HyperMD-header-2,
.theme-dark .markdown-rendered h2 {
background: var(--h2-block-bg);
}

.theme-dark .cm-line.HyperMD-header-1::after,
.theme-dark .markdown-rendered h1::after {
background: linear-gradient(
to right,
var(--h1-block-bg) 0%,
var(--h1-after-bg) 10%
);
}

.theme-dark .cm-line.HyperMD-header-2::after,
.theme-dark .markdown-rendered h2::after {
background: linear-gradient(
to right,
var(--h2-block-bg) 0%,
var(--h2-after-bg) 10%
);
}

/* H3方块(实时预览) */
.theme-dark .cm-line.HyperMD-header-3 .cm-header-3 {
background: var(--h3-block-bg);
padding: 0em 0.1em;
color: color-mix(in srgb, var(--h3-text-base) var(--h3-text-level), black);
-webkit-box-decoration-break: clone;
box-decoration-break: clone;
}

/* H4方块(实时预览) */
.theme-dark .cm-line.HyperMD-header-4 .cm-header-4 {
background: var(--h4-block-bg);
padding: 0em 0.1em;
color: color-mix(in srgb, var(--h4-text-base) var(--h4-text-level), black);
-webkit-box-decoration-break: clone;
box-decoration-break: clone;
}

/* H1方块(阅读模式) */
.theme-dark .markdown-rendered h1 {
background: var(--h1-block-bg);
width: 100%;
padding: 0em 0.1em;
color: color-mix(in srgb, var(--h1-text-base) var(--h1-text-level), black);
}

/* H2方块(阅读模式) */
.theme-dark .markdown-rendered h2 {
background: var(--h2-block-bg);
width: 100%;
padding: 0em 0.1em;
color: color-mix(in srgb, var(--h2-text-base) var(--h2-text-level), black);
}

/* H3方块(阅读模式) */
.theme-dark .markdown-rendered h3 {
background: var(--h3-block-bg);
width: fit-content;
padding: 0em 0.1em;
color: color-mix(in srgb, var(--h3-text-base) var(--h3-text-level), black);
margin-block: var(--h3-margin-y);
}

/* 暗色模式下,有方块则屏蔽左侧色条 */
.theme-dark .cm-line.HyperMD-header-1::before,
.theme-dark .cm-line.HyperMD-header-2::before,
.theme-dark .cm-line.HyperMD-header-3::before,
.theme-dark .cm-line.HyperMD-header-4::before,
.theme-dark .markdown-rendered h1::before,
.theme-dark .markdown-rendered h2::before,
.theme-dark .markdown-rendered h3::before,
.theme-dark .markdown-rendered h4::before {
display: none;
}

/* 实时预览 */
.cm-line.HyperMD-header-1 { --hbar-color: var(--hbar-1); }
.cm-line.HyperMD-header-2 { --hbar-color: var(--hbar-2); }
.cm-line.HyperMD-header-3 { --hbar-color: var(--hbar-3); }
.cm-line.HyperMD-header-4 { --hbar-color: var(--hbar-4); }
.cm-line.HyperMD-header-5 { --hbar-color: var(--hbar-5); }
.cm-line.HyperMD-header-6 { --hbar-color: var(--hbar-6); }

/* 阅读模式 */
.markdown-rendered h1 { --hbar-color: var(--hbar-1); }
.markdown-rendered h2 { --hbar-color: var(--hbar-2); }
.markdown-rendered h3 { --hbar-color: var(--hbar-3); }
.markdown-rendered h4 { --hbar-color: var(--hbar-4); }
.markdown-rendered h5 { --hbar-color: var(--hbar-5); }
.markdown-rendered h6 { --hbar-color: var(--hbar-6); }

/* ==================== 边框 ==================== */
body {
    /* 颜色 */
    --h1-border-color: #999;
    --h2-border-color: #999;
    /* 宽度 */
    --h1-border-width: 0px;
    --h2-border-width: 4px;
    /* 线型 */
    --h1-border-style: solid;
    --h2-border-style: solid;
    /* 角弧 */
    --h1-border-radius: 0px;
    --h2-border-radius: 0px;
}

/* 使用真正的border,让边框计入CodeMirror的行高与行位置测量,这样下边框会自然推开下一行,行号也会按同一行高同步,无需额外margin补偿。display: block的修复保持不变,避免标题识别瞬间切换flex布局 */
.markdown-source-view.mod-cm6 .cm-line.HyperMD-header-1 {
    border: var(--h1-border-width) var(--h1-border-style) var(--h1-border-color);
    outline: none;
    margin-block: 0 !important;
    border-radius: var(--h1-border-radius);
    box-sizing: border-box;
}

.markdown-source-view.mod-cm6 .cm-line.HyperMD-header-2 {
    border: var(--h2-border-width) var(--h2-border-style) var(--h2-border-color);
    outline: none;
    margin-block: 0 !important;
    border-radius: var(--h2-border-radius);
    box-sizing: border-box;
}

/* 阅读模式 */
.markdown-rendered h1 {
    border: var(--h1-border-width) var(--h1-border-style) var(--h1-border-color);
    border-radius: var(--h1-border-radius);
    box-sizing: border-box;
}

/* ==================== H3 上下留白 ========== */
.markdown-source-view.mod-cm6 .HyperMD-header-3 {
padding-top: 0.3em;
padding-bottom: 0.2em;
}

/* ==================== 前导符 ==================== */
body {
/* H3前导符 */
  --h3-leader-color: #555;         /* var(--text-muted) */
  --h3-leader-thickness: 2px;
  --h3-leader-gap: 0.05em;
  --h3-leader-opacity: 0.5;
  --h3-leader-min-width: 2em;
}

/* 阅读模式标题布局 */
.markdown-rendered h3 {
display: flex;
align-items: center;
}

/* 实时预览标题布局: 不改变CodeMirror编辑行的display类型 */
.markdown-source-view.mod-cm6 .cm-line.HyperMD-header-3 {
display: block;
position: relative;
}

/* H3实线前导符(阅读模式) */
.markdown-rendered h3::after {
content: "";
flex: 1 1 auto;
min-width: var(--h3-leader-min-width);
margin-left: var(--h3-leader-gap);
border-top: var(--h3-leader-thickness) solid var(--h3-leader-color);
opacity: var(--h3-leader-opacity);
}

/* H3实线前导符(实时预览): 不参与文字布局 */
.markdown-source-view.mod-cm6 .cm-line.HyperMD-header-3::after {
content: "";
position: absolute;
position-anchor: --heading-text;
top: 50%;
right: 0;
left: anchor(right);
min-width: var(--h3-leader-min-width);
margin-left: var(--h3-leader-gap);
border-top: var(--h3-leader-thickness) solid var(--h3-leader-color);
opacity: var(--h3-leader-opacity);
transform: translateY(-50%);
pointer-events: none;
}

/* 为实时预览的右侧装饰提供文字末尾锚点 */
.markdown-source-view.mod-cm6 .cm-line.HyperMD-header-1 .cm-header-1,
.markdown-source-view.mod-cm6 .cm-line.HyperMD-header-2 .cm-header-2,
.markdown-source-view.mod-cm6 .cm-line.HyperMD-header-3 .cm-header-3 {
anchor-name: --heading-text;
}
