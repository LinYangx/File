/* ==================== Callout、引用块、无序列表、有序列表 =============== */
.markdown-source-view.mod-cm6.is-live-preview
  :is(.cm-callout, .HyperMD-quote, .HyperMD-list-line)
  + .cm-line:has(> br:only-child):not(.cm-active) {
  line-height: 0;
  min-height: 0;
  padding-top: 0;
  padding-bottom: 0;
}

/* ==================== Tab缩进 ==================== */
.markdown-source-view.mod-cm6.is-live-preview
.cm-line:has(.cm-indent)
+ .cm-line:not(.cm-active):is(:empty, :has(> br:only-child)) {
  display: none !important;
}

/* ==================== 表格 ==================== */
.markdown-source-view.mod-cm6.is-live-preview
  .cm-line:has(> br:only-child):not(.cm-active):has(+ .cm-table-widget),
.markdown-source-view.mod-cm6.is-live-preview
  .cm-table-widget
  + .cm-line:has(> br:only-child):not(.cm-active) {
  line-height: 0;
  min-height: 0;
  padding-top: 0;
  padding-bottom: 0;
}

/* ==================== 行号 ==================== */
body {
  --collapsed-line-marker-color: hsla(258, 70%, 66%, 1);     /* 横线颜色 */
  --collapsed-line-marker-offset: -0.55em;     /* 横线纵向位置(越小越靠上) */
}

/* 隐藏高度为0的行号数字 */
.markdown-source-view.mod-cm6.is-live-preview
  .cm-lineNumbers
  .cm-gutterElement[style*="height: 0px"] {
  position: relative;
  color: transparent !important;
}

/* 在原行号位置显示横线,并移到下一行行号上方 */
.markdown-source-view.mod-cm6.is-live-preview
  .cm-lineNumbers
  .cm-gutterElement[style*="height: 0px"]::before {
  content: "---";
  position: absolute;
  top: var(--collapsed-line-marker-offset);
  right: 5px;
  z-index: 1;

  color: var(--collapsed-line-marker-color);
  font-size: inherit;
  font-weight: 900;
  line-height: 1;
  pointer-events: none;
}
